<UserControl
    x:Class="PoVoiceHud.App.Views.TranscriptStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:PoVoiceHud.Core"
    xmlns:local="using:PoVoiceHud.App.Views">
    <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="12,8">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Transcript, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="2" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="core:TranscriptLine">
                    <TextBlock FontSize="12" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind local:TranscriptStrip.Stamp(Source, At)}" />
                        <Run Text="{x:Bind Text}" />
                    </TextBlock>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </Border>
</UserControl>
