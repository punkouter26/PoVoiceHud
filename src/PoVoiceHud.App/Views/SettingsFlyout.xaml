<UserControl
    x:Class="PoVoiceHud.App.Views.SettingsFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoVoiceHud.App.Views"
    Width="400">
    <!-- The window sets MaxHeight to what the screen has room for each time this opens (FitTo). -->
    <ScrollViewer x:Name="Scroller" MaxHeight="640">
        <StackPanel Spacing="10" Padding="4">

            <!-- 1. Where the claims are checked: an Azure AI Foundry resource and its key. The model is built in. -->
            <TextBox Header="Azure AI Foundry endpoint" Text="{x:Bind ViewModel.Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="https://&lt;resource&gt;.services.ai.azure.com" />
            <PasswordBox Header="Key" Password="{x:Bind ViewModel.Key, Mode=TwoWay}"
                         PlaceholderText="{x:Bind local:SettingsFlyout.KeyPlaceholder(ViewModel.HasKey), Mode=OneWay}" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Check" Command="{x:Bind ViewModel.CheckCommand}"
                        ToolTipService.ToolTip="Send one message to the model with the endpoint and key typed above" />
                <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind local:SettingsFlyout.Dot(ViewModel.CheckResult), Mode=OneWay}" />
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CheckResult, Mode=OneWay}" Style="{StaticResource HudCaption}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.EndpointError, Mode=OneWay}" Style="{StaticResource HudError}" TextWrapping="Wrap"
                       Visibility="{x:Bind local:SettingsFlyout.Shown(ViewModel.EndpointError), Mode=OneWay}" />
            <TextBlock Style="{StaticResource HudCaption}" TextWrapping="Wrap"
                       Text="Claims are checked by gpt-4.1-mini, so the resource needs a deployment of that name. The key is kept in Windows Credential Manager." />

            <!-- 2. Four switches, two by two. The longer explanations are in the tooltips. -->
            <Grid ColumnSpacing="12" RowSpacing="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ToggleSwitch Header="Wikipedia look-ups" IsOn="{x:Bind ViewModel.LookUpClaims, Mode=TwoWay}" MinWidth="0"
                              AutomationProperties.HelpText="{x:Bind ViewModel.LookUpNote, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind ViewModel.LookUpNote, Mode=OneWay}" />
                <ToggleSwitch Grid.Column="1" Header="Also listen to the call" IsOn="{x:Bind ViewModel.ListenToCall, Mode=TwoWay}" MinWidth="0"
                              ToolTipService.ToolTip="Transcribe and check what the other side of a call says (the speakers' audio) as well as your microphone. Lines are then labelled You and Them." />
                <ToggleSwitch Grid.Row="1" Header="Start with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" MinWidth="0" />
                <ToggleSwitch Grid.Row="1" Grid.Column="1" Header="Sounds and animations" IsOn="{x:Bind ViewModel.Sounds, Mode=TwoWay}" MinWidth="0"
                              ToolTipService.ToolTip="A short cue for each verdict and for mute (each under a quarter of a second, so call audio never transcribes it), and the highlight fading in" />
            </Grid>

            <!-- 3. Quitting: the pill has no close button -->
            <Grid ColumnSpacing="8" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource HudCaption}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Changes apply when this panel closes." />
                <Button Grid.Column="1" Content="Quit PoVoiceHud" Click="Quit_Click" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
