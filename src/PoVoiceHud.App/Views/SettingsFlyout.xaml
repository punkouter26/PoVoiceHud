<UserControl
    x:Class="PoVoiceHud.App.Views.SettingsFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoVoiceHud.App.Views"
    Width="400">
    <ScrollViewer MaxHeight="640">
        <StackPanel Spacing="12" Padding="4">

            <!-- 1. The fact-check model: one line once it is set up -->
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsModelCollapsed, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Fact-check model" Style="{StaticResource HudCaption}" />
                    <TextBlock Text="{x:Bind ViewModel.ModelSummary, Mode=OneWay}" Style="{StaticResource HudHeadline}"
                               ToolTipService.ToolTip="{x:Bind ViewModel.ModelSummary, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Change…" Command="{x:Bind ViewModel.ChangeModelCommand}" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsEditingModel, Mode=OneWay}">
                <ComboBox Header="Fact-check model" ItemsSource="{x:Bind ViewModel.Providers}" SelectedItem="{x:Bind ViewModel.Provider, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" />
                <TextBox Header="Endpoint" Text="{x:Bind ViewModel.FoundryEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="https://&lt;resource&gt;.services.ai.azure.com" Visibility="{x:Bind ViewModel.IsFoundry, Mode=OneWay}" />
                <TextBox Header="Model" Text="{x:Bind ViewModel.FoundryModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox Header="API key" Password="{x:Bind ViewModel.FoundryKey, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsFoundry, Mode=OneWay}"
                             PlaceholderText="{x:Bind local:SettingsFlyout.KeyPlaceholder(ViewModel.HasFoundryKey), Mode=OneWay}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Test" Command="{x:Bind ViewModel.TestCommand}" ToolTipService.ToolTip="Send one message to the model with what is typed above" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TestResult, Mode=OneWay}" Style="{StaticResource HudCaption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.FoundryError, Mode=OneWay}" Style="{StaticResource HudError}" TextWrapping="Wrap"
                       Visibility="{x:Bind local:SettingsFlyout.Shown(ViewModel.FoundryError), Mode=OneWay}" />

            <!-- 2. An optional repository. Having one is what turns on the call audio and the answers from the code. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="Repository (optional)" Text="{x:Bind ViewModel.RepoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Azure DevOps URL, or a folder" />
                <Button Grid.Column="1" Content="Browse…" Command="{x:Bind ViewModel.BrowseCommand}" VerticalAlignment="Bottom" />
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.RepoError, Mode=OneWay}" Style="{StaticResource HudError}" TextWrapping="Wrap"
                       Visibility="{x:Bind local:SettingsFlyout.Shown(ViewModel.RepoError), Mode=OneWay}" />
            <!-- The token and the connection test only matter once there is a repository. -->
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasRepo, Mode=OneWay}">
                <PasswordBox Header="Azure DevOps access token" Password="{x:Bind ViewModel.AzdoPat, Mode=TwoWay}"
                             PlaceholderText="{x:Bind local:SettingsFlyout.KeyPlaceholder(ViewModel.HasAzdoPat), Mode=OneWay}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Test repository" Command="{x:Bind ViewModel.TestRepoCommand}" ToolTipService.ToolTip="Open the folder, or ask the URL for its branches using the token" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RepoTestResult, Mode=OneWay}" Style="{StaticResource HudCaption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <TextBlock Style="{StaticResource HudCaption}" TextWrapping="Wrap"
                       Text="Without a repository the app fact-checks what you say. With one it also listens to the call and answers from the code. Changes apply when you close this panel." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
