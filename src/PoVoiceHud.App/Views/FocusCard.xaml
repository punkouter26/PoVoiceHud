<UserControl
    x:Class="PoVoiceHud.App.Views.FocusCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PoVoiceHud.Core.ViewModels">
    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" Padding="6,1">
                    <TextBlock Text="{x:Bind Card.Tag, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="{x:Bind Card.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{x:Bind Card.Answer, Mode=OneWay}" FontSize="15" TextWrapping="Wrap" MaxLines="3" />
            <TextBlock Text="{x:Bind Card.Stale, Mode=OneWay}" Visibility="{x:Bind Card.IsStale, Mode=OneWay}" FontSize="12"
                       TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <ItemsRepeater ItemsSource="{x:Bind Card.Jumps, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:JumpItem">
                        <HyperlinkButton Command="{x:Bind OpenCommand}" Padding="6,2" FontSize="12">
                            <TextBlock>
                                <Run Text="[Jump] " FontWeight="SemiBold" /><Run Text="{x:Bind Label}" />
                            </TextBlock>
                        </HyperlinkButton>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <HyperlinkButton Command="{x:Bind Card.OpenLinkCommand, Mode=OneWay}" Visibility="{x:Bind Card.HasLink, Mode=OneWay}"
                             Content="Open ↗" Padding="6,2" FontSize="12" />
        </StackPanel>
    </Border>
</UserControl>
