<UserControl
    x:Class="PoVoiceHud.App.Views.ConstellationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Height="190">
    <!-- G10: this session's cards as stars. Time runs left to right, related claims are pulled together, colour is the verdict
         and size the confidence. Hovering names a star; clicking brings its card back. The sky is always dark, so its text is fixed white. -->
    <Grid Background="Transparent" PointerMoved="Sky_PointerMoved" PointerExited="Sky_PointerExited" Tapped="Sky_Tapped"
          AutomationProperties.Name="Constellation of this session's cards">
        <win2d:CanvasControl x:Name="Sky" ClearColor="Transparent" Draw="Sky_Draw" />
        <TextBlock x:Name="Empty" Text="Each card of this session becomes a star here." Style="{StaticResource HudCaption}" Foreground="#B3FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        <TextBlock Text="this session · time →" Style="{StaticResource HudCaption}" Foreground="#80FFFFFF" FontSize="11"
                   Margin="10,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False" />
        <Border x:Name="Label" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="320"
                Background="#E6101020" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,3" IsHitTestVisible="False">
            <TextBlock x:Name="LabelText" Style="{StaticResource HudCaption}" Foreground="White" TextWrapping="Wrap" MaxLines="2" />
        </Border>
    </Grid>
</UserControl>
