<UserControl
    x:Class="PoVoiceHud.App.Views.ShelfCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PoVoiceHud.Core.ViewModels"
    Width="220">
    <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6" Padding="10,8">
        <StackPanel Spacing="4">
            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                <Run Text="{x:Bind Card.Tag, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Run Text=" " /><Run Text="{x:Bind Card.Title, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Text="{x:Bind Card.Answer, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="⚠ STALE" Visibility="{x:Bind Card.IsStale, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <ItemsRepeater ItemsSource="{x:Bind Card.Jumps, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:JumpItem">
                        <HyperlinkButton Command="{x:Bind OpenCommand}" Content="{x:Bind Label}" Padding="4,0" FontSize="11" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <HyperlinkButton Command="{x:Bind Card.OpenLinkCommand, Mode=OneWay}" Visibility="{x:Bind Card.HasLink, Mode=OneWay}"
                             Content="Open ↗" Padding="4,0" FontSize="11" />
        </StackPanel>
    </Border>
</UserControl>
