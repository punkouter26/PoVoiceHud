root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,xaml}]
indent_size = 4

[*.{csproj,props,json,md}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Analyzer rules switched off, each for a stated reason:
# CA1716 — names clashing with Visual Basic keywords (Stop); this code is only ever consumed from C#.
dotnet_diagnostic.CA1716.severity = none
# CA1848 — source-generated log delegates; the log calls here are on failure paths or once-per-event ones (start, settings, update), not hot ones.
dotnet_diagnostic.CA1848.severity = none
# CA1873 — lazy evaluation of log arguments; same reason: nothing is logged per utterance or per audio frame.
dotnet_diagnostic.CA1873.severity = none

# WinUIEx marks WindowEx.Icon obsolete and the XAML compiler still emits a reference to it.
# That is the only place the obsolete-member warning is waived; everywhere else it stays an error.
[**/XamlTypeInfo.g.cs]
dotnet_diagnostic.CS0618.severity = none

[tests/**.cs]
# Test names are sentences with underscores; assertions compare fixed ASCII text, so culture rules add nothing;
# and no test class is ever subclassed, so the finalizer-suppression pattern has no one to protect.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1816.severity = none
